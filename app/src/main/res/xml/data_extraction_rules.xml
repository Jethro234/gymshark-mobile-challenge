<?xml version="1.0" encoding="utf-8"?>
<!--
  No exclusions: the app persists no user data at all (read-only product
  catalogue, in-memory cache only), so there is nothing to exclude from
  cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
